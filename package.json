{
  "name": "@judepayne/picode",
  "version": "1.0.0",
  "description": "A Pi package for disciplined, role-based coding workflows with mode switching, permissions, subagents, and prompt vars.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/judepayne/picode.git"
  },
  "homepage": "https://github.com/judepayne/picode#readme",
  "bugs": {
    "url": "https://github.com/judepayne/picode/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "ai-agent",
    "subagent",
    "workflow",
    "prompt-vars",
    "planner",
    "builder",
    "designer"
  ],
  "scripts": {
    "test": "node --test \"extensions/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke:gate-auto": "node scripts/smoke-gate-auto-soft-block.mjs",
    "build:npm": "node scripts/build-npm-package.mjs",
    "publish:npm:dry-run": "npm run build:npm && npm publish ./dist --dry-run --access public",
    "publish:npm": "npm run build:npm && npm publish ./dist --access public"
  },
  "files": [
    "extensions",
    "!extensions/**/test",
    "!extensions/**/*.test.ts",
    "!extensions/**/fixtures",
    "skills",
    "examples",
    "img",
    "scripts/setup-gate-auto-approver.mjs",
    "scripts/eval-gate-auto-approver.mjs",
    "scripts/smoke-gate-auto-soft-block.mjs",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    "./agent-assets-contract": "./extensions/agent-assets/contract.ts",
    "./subagent-orchestrator": "./extensions/subagent-orchestrator/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/judepayne/picode/main/img/picode-preview.png"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "24.12.4",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
