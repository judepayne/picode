{
  "name": "@judepayne/picode",
  "version": "1.0.0",
  "description": "A Pi package for disciplined, role-based coding workflows with mode switching, permissions, subagents, and prompt vars.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/judepayne/picode.git"
  },
  "homepage": "https://github.com/judepayne/picode#readme",
  "bugs": {
    "url": "https://github.com/judepayne/picode/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "ai-agent",
    "subagent",
    "workflow",
    "prompt-vars",
    "planner",
    "builder",
    "designer"
  ],
  "scripts": {
    "build:npm": "node scripts/build-npm-package.mjs",
    "publish:npm:dry-run": "npm run build:npm && npm publish ./dist --dry-run --access public",
    "publish:npm": "npm run build:npm && npm publish ./dist --access public"
  },
  "files": [
    "extensions",
    "!extensions/**/test",
    "!extensions/**/*.test.ts",
    "!extensions/**/fixtures",
    "skills",
    "examples",
    "img",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    "./agent-assets-contract": "./extensions/agent-assets/contract.ts"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "image": "https://raw.githubusercontent.com/judepayne/picode/main/img/picode-preview.png"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  }
}
